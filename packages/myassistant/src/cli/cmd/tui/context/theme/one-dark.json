{
  "$schema": "https://myassistant.ai/theme.json",
  "defs": {
    "darkBg": "#282822",
    "darkBgAlt": "#21252b",
    "darkBgPanel": "#353b45",
    "darkFg": "#abb2bf",
    "darkFgMuted": "#5c6370",
    "darkPurple": "#c678dd",
    "darkBlue": "#61afef",
    "darkRed": "#e06c75",
    "darkGreen": "#98c379",
    "darkYellow": "#e5c07b",
    "darkOrange": "#d19a66",
    "darkCyan": "#56b6c2",
    "lightBg": "#fafafa",
    "lightBgAlt": "#f0f0f1",
    "lightBgPanel": "#eaeaeb",
    "lightFg": "#383a42",
    "lightFgMuted": "#a0a1a7",
    "lightPurple": "#a626a4",
    "lightBlue": "#4078f2",
    "lightRed": "#e45649",
    "lightGreen": "#50a14f",
    "lightYellow": "#c18401",
    "lightOrange": "#986801",
    "lightCyan": "#0184bc"
  },
  "theme": {
    "primary": { "dark": "blue", "light": "blue" },
    "secondary": { "dark": "purple", "light": "purple" },
    "accent": { "dark": "cyan", "light": "cyan" },
    "error": { "dark": "red", "light": "red" },
    "warning": { "dark": "yellow", "light": "orange" },
    "success": { "dark": "green", "light": "green" },
    "info": { "dark": "orange", "light": "orange" },
    "text": { "dark": "darkFg", "light": "darkFg" },
    "textMuted": { "dark": "darkFgMuted", "light": "darkFgMuted" },
    "background": { "dark": "darkBg", "light": "lightBg" },
    "backgroundPanel": { "dark": "darkBgAlt", "light": "lightBgAlt" },
    "backgroundElement": { "dark": "darkBgPanel", "light": "lightBgPanel" },
    "border": { "dark": "darkBg3", "light": "lightBg3" },
    "borderActive": { "dark": "darkBg4", "light": "lightBg4" },
    "borderSubtle": { "dark": "darkBg2", "light": "lightBg2" },
    "diffAdded": { "dark": "darkGreen", "light": "green" },
    "diffRemoved": { "dark": "darkRed", "light": "red" },
    "diffContext": { "dark": "darkFgMuted", "light": "darkFgMuted" },
    "diffHunkHeader": { "dark": "darkFgMuted", "light": "darkFgMuted" },
    "diffHighlightAdded": { "dark": "darkGreen", "light": "green" },
    "diffHighlightRemoved": { "dark": "darkRed", "light": "red" },
    "diffAddedBg": { "dark": "#1a3a1a", "light": "#e0ffe0" },
    "diffRemovedBg": { "dark": "#37222c", "light": "#f7d8db" },
    "diffContextBg": { "dark": "darkBgAlt", "light": "lightBgAlt" },
    "diffLineNumber": { "dark": "#8f8f8f", "light": "#595959" },
    "diffAddedLineNumberBg": { "dark": "#1b2b34", "light": "#c5d5c5" },
    "diffRemovedLineNumberBg": { "dark": "#2d1f26", "light": "#e7c8cb" },
    "markdownText": { "dark": "darkStep12", "light": "lightStep12" },
    "markdownHeading": { "dark": "darkAccent", "light": "darkAccent" },
    "markdownLink": { "dark": "cyan", "light": "cyan" },
    "markdownLinkText": { "dark": "pink", "light": "pink" },
    "markdownCode": { "dark": "green", "light": "green" },
    "markdownBlockQuote": { "dark": "comment", "light": "#6272a4" },
    "markdownEmph": { "dark": "yellow", "light": "orange" },
    "markdownStrong": { "dark": "orange", "light": "orange" },
    "markdownHorizontalRule": { "dark": "comment", "light": "#6272a4" },
    "markdownListItem": { "dark": "purple", "light": "purple" },
    "markdownListEnumeration": { "dark": "cyan", "light": "cyan" },
    "markdownImage": { "dark": "cyan", "light": "cyan" },
    "markdownImageText": { "dark": "pink", "light": "pink" },
    "markdownCodeBlock": { "dark": "foreground", "light": "#282a36" },
    "syntaxComment": { "dark": "comment", "light": "#6272a4" },
    "syntaxKeyword": { "dark": "pink", "light": "pink" },
    "syntaxFunction": { "dark": "green", "light": "green" },
    "syntaxVariable": { "dark": "foreground", "light": "#282a36" },
    "syntaxString": { "dark": "yellow", "light": "yellow" },
    "syntaxNumber": { "dark": "purple", "light": "purple" },
    "syntaxType": { "dark": "cyan", "light": "cyan" },
    "syntaxOperator": { "dark": "pink", "light": "pink" },
    "syntaxPunctuation": { "dark": "foreground", "light": "#282a36" }
  }
}
